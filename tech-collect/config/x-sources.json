{
  "description": "X.com/Twitter 技术观察采集源配置",
  "update_frequency": "daily",
  "time_window_days": 3,
  "collection_strategies": [
    {
      "priority": 1,
      "name": "mearl_browser",
      "desc": "Mearl 复用浏览器登录态：page_navigate + page_scroll + page_eval 抽取 DOM（首选，已验证可用）",
      "reliability": "high"
    },
    {
      "priority": 2,
      "name": "x_api",
      "desc": "X API v2 Basic Tier（付费 $100/月，无浏览器环境时用）",
      "reliability": "high"
    },
    {
      "priority": 3,
      "name": "websearch",
      "desc": "WebSearch 间接覆盖（降级，覆盖面不全）",
      "reliability": "medium"
    },
    {
      "priority": 4,
      "name": "nitter_rss",
      "desc": "Nitter 等第三方 RSS 代理（当前网络下不可达，仅作外部环境备选）",
      "reliability": "low"
    }
  ],
  "mearl": {
    "setup": "npx @mearl/setup --yes",
    "browser_check": "mearl browser_list",
    "domain_permission": "mearl request_domain_permission --payload '{\"domain\":\"x.com\"}'",
    "collect_script": "tech-collect/tmp/x-collect.sh",
    "retry_script": "tech-collect/tmp/x-collect-retry.sh"
  },
  "nitter_instances": [
    "https://nitter.poast.org",
    "https://nitter.privacydev.net",
    "https://twiiit.com"
  ],
